# ブラウザに埋め込まれます。service_role や秘密鍵は絶対に入れないでください。
# Supabase Dashboard → Project Settings → API の Project URL と anon（公開）キーです。
VITE_SUPABASE_URL=https://ofpaiegiilfxloprmcwi.supabase.co
VITE_SUPABASE_ANON_KEY=

# コーポレートサイトのベースURL（任意）。未設定のときはコード内の仮URLを使います。
# 本番の独自ドメインは【未定】です。末尾のスラッシュは不要です。
# VITE_CORPORATE_BASE_URL=

# 1 または true のときだけ、公開ページを検索対象にする。未設定のあいだは全ページ noindex。
# 空欄（返信日数、特商法、規約）が残っているあいだは付けない。
# VITE_ALLOW_INDEX=
